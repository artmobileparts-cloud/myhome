<?xml version="1.0" encoding="utf-8"?>
<!-- Цвета обложки сняты с ЖИВОГО экрана приложения (сборка 25.08-575), а не
     из :root прототипа: TOK накладывает оверрайды на .screen, и в :root лежат
     другие значения. Держим согласие, иначе заставка мигнёт одним цветом, а
     приложение откроется другим.

     Имена в скобках без двойного дефиса: в комментариях XML он запрещён. -->
<resources>
    <color name="colorPrimary">#5B4BE8</color>     <!-- accent экрана  -->
    <color name="colorPrimaryDark">#0C0C0E</color> <!-- ink            -->
    <color name="colorAccent">#5B4BE8</color>      <!-- accent экрана  -->
    <color name="brandBg">#F7F8FC</color>          <!-- bg экрана      -->
    <color name="brandSurface">#FFFFFF</color>     <!-- surface        -->
</resources>
